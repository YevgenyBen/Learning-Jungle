# Azure Speech key for generating Voice Clips (npm run voice-clips).
# Copy this file to .env.azure.local (git ignores it) and fill in your own
# Speech resource's key and region from the Azure portal
# (Speech resource > Keys and Endpoint). Never commit the real key.
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=your-region
# Optional: milliseconds between requests. The free tier (F0) allows about
# 20 requests a minute, hence the default of 3100. On a paid tier, 0 is fine.
# AZURE_SPEECH_MIN_INTERVAL_MS=3100
