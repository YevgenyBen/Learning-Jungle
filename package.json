{
  "name": "learning-jungle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:build": "node scripts/check-production-build.mjs",
    "pictures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-pictures.mjs",
    "voice-clips": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice-clips.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run test:build"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@twemoji/svg": "15.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
